# Chat model and embedding model use Pydantic AI provider strings.
RAG_MODEL=ollama:qwen3:4b
RAG_EMBED_MODEL=ollama:bge-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenAI / Anthropic instead of a local Ollama server:
# RAG_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=sk-...
# RAG_EMBED_MODEL=openai:text-embedding-3-small

# web_search uses DuckDuckGo by default; these keys take priority when set.
# TAVILY_API_KEY=tvly-...
# BRAVE_API_KEY=...

# Retrieval knobs.
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=6

# Set to 1 to rebuild the FAISS index on startup.
# RAG_REBUILD=1
